{
  "name": "@ata-project/mcp",
  "version": "0.1.0",
  "description": "JSON Schema validation provider for the Model Context Protocol TypeScript SDK, for runtimes that do not allow code generation",
  "license": "MIT",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "index.js",
    "index.d.ts",
    "build.js",
    "build.d.ts",
    "README.md"
  ],
  "scripts": {
    "test": "node test.js"
  },
  "dependencies": {
    "ata-validator": "^1.20.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "json-schema",
    "validation",
    "cloudflare-workers",
    "csp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./build": {
      "types": "./build.d.ts",
      "default": "./build.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ata-core/ata-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ata-core/ata-mcp/issues"
  },
  "homepage": "https://github.com/ata-core/ata-mcp#readme"
}
